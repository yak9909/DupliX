+                      !ws->AEGP_GetBaseAddr8(w1, &p1);
+            if (ok) {
+                for (A_long y = 0; y < h * f; y++) {
+                    const PF_Pixel8* s = (const PF_Pixel8*)((const char*)p0 + (size_t)(y / f) * rb0);
